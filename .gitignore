# Data folders (too large for GitHub) - anchored to repo root so they don't
# match nested package paths such as ml_core/data/.
/data/
/data_cleaned/
/delta_lake/
/volumes/

# Python environment
cerebro_env/
__pycache__/
*.pyc
*.pyo

# EEG data files
*.fif
*.edf
*.gdf

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Logs
*.log
*.jsonl

# Python venvs
.venv/
venv/

# ML run artifacts (keep folder placeholders only)
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts/mlruns/*
!artifacts/mlruns/.gitkeep

